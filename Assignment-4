# Validate email
def valid_email(email):

    email = email.strip()

    if " " in email:
        return False

    if email.count("@") != 1:
        return False

    parts = email.split("@")

    if parts[0] == "" or "." not in parts[1]:
        return False

    if parts[1].startswith(".") or parts[1].endswith("."):
        return False

    return True


# Main processing function
def process_files():

    seen = set()
    master = []
    event_data = {}

    total = 0
    duplicates = 0
    invalid = 0
    damaged = 0
    accepted = 0

    errors = []

    # Read five department files
    for dept in departments:

        filename = "input/" + dept + ".txt"

        if not os.path.exists(filename):
            errors.append("Missing file: " + filename)
            continue

        try:
            with open(filename, "r") as file:

                for line_no, line in enumerate(file, 1):

                    total += 1

                    try:
                        parts = line.strip().split("|")

                        if len(parts) != 5:
                            damaged += 1
                            errors.append(
                                filename + " Line " +
                                str(line_no) + ": Damaged line"
                            )
                            continue

                        reg, name, department, email, events = parts

                        reg = reg.strip()
                        name = name.strip()
                        department = department.strip().upper()
                        email = email.strip().lower()

                        if not reg or not name or not department:
                            damaged += 1
                            errors.append(
                                filename + " Line " +
                                str(line_no) + ": Missing field"
                            )
                            continue

                        if not valid_email(email):
                            invalid += 1
                            errors.append(
                                filename + " Line " +
                                str(line_no) + ": Invalid email"
                            )
                            continue

                        if reg in seen:
                            duplicates += 1
                            errors.append(
                                filename + " Line " +
                                str(line_no) + ": Duplicate registration"
                            )
                            continue

                        seen.add(reg)

                        event_list = [
                            event.strip()
                            for event in events.split(",")
                            if event.strip()
                        ]

                        # Save accepted registration
                        master.append([
                            reg, name, department, email,
                            ",".join(event_list)
                        ])

                        # Store event participants
                        for event in event_list:

                            if event not in event_data:
                                event_data[event] = []

                            event_data[event].append([
                                reg, name, department, email
                            ])

                        accepted += 1

                    except Exception as e:
                        damaged += 1
                        errors.append(
                            filename + " Line " +
                            str(line_no) + ": " + str(e)
                        )

        except OSError as e:
            errors.append("Cannot read " + filename + ": " + str(e))

    # Write master list
    with open("output/master_list.csv", "w", newline="") as file:

        writer = csv.writer(file)

        writer.writerow([
            "Register Number", "Name", "Department",
            "Email", "Events"
        ])

        writer.writerows(master)

    # Write separate event files
    for event, participants in event_data.items():

        safe_name = "".join(
            ch for ch in event
            if ch.isalnum() or ch in "_-"
        )

        with open(
            "output/" + safe_name + ".csv",
            "w", newline=""
        ) as file:

            writer = csv.writer(file)

            writer.writerow([
                "Register Number", "Name",
                "Department", "Email"
            ])

            writer.writerows(participants)

    # Write summary report
    with open("output/summary.txt", "w") as file:

        file.write("COLLEGE FEST REGISTRATION SUMMARY\n")
        file.write("---------------------------------\n")
        file.write("Total records: " + str(total) + "\n")
        file.write("Accepted records: " + str(accepted) + "\n")
        file.write("Duplicate records: " + str(duplicates) + "\n")
        file.write("Invalid emails: " + str(invalid) + "\n")
        file.write("Damaged records: " + str(damaged) + "\n")
        file.write("Event files created: " + str(len(event_data)) + "\n")

    # Write error log
    with open("output/error_log.txt", "w") as file:

        if errors:
            for error in errors:
                file.write(error + "\n")
        else:
            file.write("No errors found.\n")

    # Display results
    print("\nCOLLEGE FEST REGISTRATION REPORT")
    print("--------------------------------")
    print("Total records:", total)
    print("Accepted records:", accepted)
    print("Duplicate records:", duplicates)
    print("Invalid emails:", invalid)
    print("Damaged records:", damaged)
    print("Event files:", len(event_data))

    print("\nFiles created successfully!")
    print("Check the output folder.")


# Run program
create_samples()
process_files()



import time

# Original Program
def build_plus(parts):
    text = ""
    for p in parts:
        text += p + ";"
    return text


# Redesigned Program
def build_join(parts):
    return ";".join(parts) + (";" if parts else "")


# Test input sizes
sizes = [1000, 10000, 200000]

for n in sizes:

    items = [f"Item{i}:Rs{i % 50}" for i in range(n)]

    # Original program - 3 trials
    total1 = 0
    for i in range(3):
        start = time.perf_counter()
        a = build_plus(items)
        total1 += time.perf_counter() - start

    # Redesigned program - 3 trials
    total2 = 0
    for i in range(3):
        start = time.perf_counter()
        b = build_join(items)
        total2 += time.perf_counter() - start

    # Results
    print("\nInput size:", n)
    print("Original time:", round(total1 / 3, 6))
    print("Join time:", round(total2 / 3, 6))
    print("Same output:", a == b)

print("\nValidation completed successfully")

